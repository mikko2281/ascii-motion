# Upload and duration limits for the first version
MAX_UPLOAD_MB=200
MAX_IMAGE_UPLOAD_MB=20
MAX_DURATION_SECONDS=300

# Usually these can stay as executable names when FFmpeg is in PATH.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Optional absolute path to a monospaced TrueType font.
# ASCII_FONT_PATH=C:/Windows/Fonts/consola.ttf

# Local Vite address allowed by CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Optional location for per-job temporary folders.
# TEMP_ROOT=/tmp
